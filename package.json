{
  "name": "turtle-deck",
  "productName": "Turtle Deck",
  "desktopName": "turtle-deck.desktop",
  "version": "0.2.2",
  "description": "Ứng dụng học tập offline bằng flashcard và trắc nghiệm",
  "scripts": {
    "test": "node --import ./tools/register-test-hooks.mjs --test",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "build:renderer": "esbuild src/app.js --bundle --format=esm --sourcemap --outfile=dist/app.js",
    "dev:renderer": "esbuild src/app.js --bundle --format=esm --sourcemap --outfile=dist/app.js --watch",
    "start": "node tools/build.mjs && tauri dev",
    "tauri": "tauri",
    "tauri:dev": "node tools/build.mjs && tauri dev",
    "tauri:build": "node tools/build.mjs && tauri build",
    "build:samples": "node tools/sdeck.mjs pack-all data/samples-src data/samples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viet15t12/TurtleDeck.git"
  },
  "keywords": [
    "flashcards",
    "srs",
    "quiz",
    "study",
    "education",
    "offline-first"
  ],
  "author": "Viet15t12 <quocviet15t12@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/viet15t12/TurtleDeck/issues"
  },
  "homepage": "https://github.com/viet15t12/TurtleDeck#readme",
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "marked": "^18.1.2",
    "marked-katex-extension": "^5.1.13"
  },
  "engines": {
    "node": ">=20"
  }
}
