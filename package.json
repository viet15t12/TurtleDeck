{
  "name": "turtle-deck",
  "productName": "Turtle Deck",
  "desktopName": "turtle-deck.desktop",
  "version": "0.1.3",
  "description": "Ứng dụng học tập offline bằng flashcard và trắc nghiệm",
  "main": "dist/main/index.js",
  "scripts": {
    "test": "node --import ./tools/register-test-hooks.mjs --test",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "start": "npm run build && electron .",
    "build:samples": "node tools/sdeck.mjs pack-all data/samples-src data/samples",
    "dist": "npm run build && LD_LIBRARY_PATH=\"$PWD/build/compat-lib:$LD_LIBRARY_PATH\" electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && LD_LIBRARY_PATH=\"$PWD/build/compat-lib:$LD_LIBRARY_PATH\" electron-builder -lw",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viet15t12/TurtleDeck.git"
  },
  "keywords": [
    "flashcards",
    "srs",
    "quiz",
    "study",
    "education",
    "offline-first"
  ],
  "author": "Viet15t12 <quocviet15t12@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/viet15t12/TurtleDeck/issues"
  },
  "homepage": "https://github.com/viet15t12/TurtleDeck#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "marked": "^18.1.2",
    "marked-katex-extension": "^5.1.13"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.turtledeck.app",
    "productName": "Turtle Deck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "build/icons/**/*",
      "build/icon.png",
      "logo.svg",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "maintainer": "Viet15t12 <quocviet15t12@gmail.com>",
      "category": "Education",
      "syncDesktopName": true,
      "icon": "build/icons",
      "mimeTypes": [
        "application/x-studydeck"
      ],
      "fileAssociations": [
        {
          "ext": "sdeck",
          "name": "Turtle Deck Study Deck",
          "description": "Gói bộ thẻ học tập Turtle Deck",
          "mimeType": "application/x-studydeck",
          "role": "Editor"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
